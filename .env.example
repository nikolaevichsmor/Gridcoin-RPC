# Discord Application Client ID (Defaults to official Gridcoin application)
DISCORD_CLIENT_ID=1545044211945177139

# Gridcoin RPC Credentials (configured in gridcoinresearch.conf)
RPC_USER=your_rpc_username
RPC_PASSWORD=your_rpc_password
RPC_HOST=127.0.0.1
RPC_PORT=15715

# Polling interval in seconds (minimum 15 to respect Discord IPC rate limits)
UPDATE_INTERVAL=15

# Number of update cycles before alternating status between Est. Reward and Difficulty
SWITCH_CYCLES=2

