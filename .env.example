# ===================================================================
# Gridcoin Discord Rich Presence Configuration
# ===================================================================

# Discord Application Client ID (pre-configured official Gridcoin-RPC application)
DISCORD_CLIENT_ID=1545044211945177139

# Gridcoin RPC Credentials
# Auto-detected from local gridcoinresearch.conf if omitted.
# For remote nodes (server/NAS/Raspberry Pi), specify credentials below:
# RPC_USER=
# RPC_PASSWORD=
# RPC_HOST=127.0.0.1
# RPC_PORT=15715

# Custom path to gridcoinresearch.conf (if in a non-standard location)
# GRIDCOIN_CONF=

# Presence update interval in seconds (minimum 15 to respect Discord rate limits)
UPDATE_INTERVAL=15

# Number of update cycles before alternating between Est. Reward, Difficulty, and RAC
SWITCH_CYCLES=2

# Discord Rich Presence art assets
DISCORD_LARGE_IMAGE=gridcoin
DISCORD_LARGE_TEXT=Gridcoin Network
DISCORD_SMALL_IMAGE_STAKING=staking
DISCORD_SMALL_IMAGE_OFFLINE=offline
