# Discord Application Client ID (Defaults to Gridcoin application)
DISCORD_CLIENT_ID=1545044211945177139

# Gridcoin RPC Credentials (found in gridcoinresearch.conf)
RPC_USER=grcrpcuser
RPC_PASSWORD=YourPasswordHere
RPC_HOST=127.0.0.1
RPC_PORT=15715

# Polling interval in seconds (minimum 15 to respect Discord IPC rate limits)
UPDATE_INTERVAL=15
